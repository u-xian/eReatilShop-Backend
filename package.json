{
  "name": "eretailshopbackend",
  "version": "1.0.0",
  "description": "A backend of retail management application API and payment methods",
  "main": "app.js",
  "scripts": {
    "start": "node ./bin/run.js",
    "dev": "nodemon ./bin/run.js",
    "test": "vitest --no-file-parallelism",
    "db:create": "sequelize-cli db:create",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:setup": "npm run db:create && npm run migrate && npm run seed",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all",
    "db:drop": "sequelize-cli db:drop",
    "db:reset": "npm run db:drop && npm run db:setup"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "nodejs",
    "express",
    "sequilize",
    "postgresql",
    "rest",
    "api"
  ],
  "author": "Christian Uwakristu",
  "license": "ISC",
  "dependencies": {
    "@hapi/joi-date": "^2.0.0",
    "axios": "^0.20.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.19.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dateformat": "^3.0.3",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-routemap": "^1.6.0",
    "helmet": "^4.1.1",
    "joi": "^17.2.1",
    "js-base64": "^3.4.5",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.17.20",
    "morgan": "^1.10.0",
    "njwt": "^1.0.0",
    "pg": "^8.2.1",
    "pg-hstore": "^2.3.3",
    "sequelize": "^6.37.8",
    "uuid": "^8.3.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "nodemon": "^2.0.4",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "sequelize-cli": {
      "js-beautify": "^2.0.3"
    }
  }
}
